---
import BasicLayout from './BasicLayout.astro';

interface Props {
  title: string;
  description: string;
  page?: 'travel' | 'blog';
  fullScreen?: string;
}

const { title, description, page } = Astro.props;
---

<BasicLayout description={description} page={page} title={title}>
  <div
    class="loader bg-gray-100 dark:bg-darkslate-500 text-neutral-900 dark:text-neutral-50 text-3xl font-black uppercase flex justify-center items-center w-screen h-screen z-50 fixed top-0 bottom-0 right-0 left-0"
    slot="loader"
  >
  </div>
  <slot />
</BasicLayout>
