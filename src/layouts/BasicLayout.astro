---
import { LINKS } from '../lib/constants';
import CursorFollower from '../components/CursorFollower.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
  title: string;
  description: string;
  page?: 'travel' | 'blog';
  slug?: string | undefined;
  pubDate?: string;
  coverImage?: string;
}

const { title, description, page, slug, pubDate, coverImage } = Astro.props;

const isArticle = page === 'blog' && Boolean(slug);
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin).href;

const ogImage = coverImage
  ? (coverImage.startsWith('http') ? coverImage : `${Astro.url.origin}${coverImage.startsWith('/') ? '' : '/'}${coverImage}`)
  : (page === 'travel'
    ? `${Astro.url.origin}/globe_preview.png`
    : `${Astro.url.origin}/og-image.png`);

const personSchema = {
  '@type': 'Person',
  '@id': `${Astro.url.origin}/#person`,
  name: 'Shardul Kavar',
  alternateName: ['Shardul Patel', 'Shardul'],
  url: Astro.url.origin,
  image: `${Astro.url.origin}/me.png`,
  jobTitle: 'Full-Stack Developer & Backend Architect',
  description:
    'Full-stack software developer and backend architect specializing in fintech systems, 25+ PSP payment integrations, and scalable microservices.',
  sameAs: [LINKS.linkedin, LINKS.github, LINKS.chess],
  email: `mailto:${LINKS.email}`,
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'India',
  },
  knowsAbout: [
    'Full-Stack Development',
    'Backend Architecture',
    'Fintech Infrastructure',
    'Payment Service Provider (PSP) Integration',
    'KYC/AML Compliance Pipelines',
    'Microservices Architecture',
    'Node.js',
    'TypeScript',
    'JavaScript',
    'PostgreSQL',
    'MongoDB',
    'Redis',
    'RabbitMQ',
    'ElasticSearch',
    'React.js',
    'Next.js',
    'SolidJS',
    'Astro',
    'Docker',
    'AWS (EC2, ECS, ECR, S3, Lambda)',
    'REST APIs',
    'GraphQL',
    'Plaid API',
    'Stripe Integration',
    'Razorpay Integration',
  ],
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': `${Astro.url.origin}/#website`,
  url: Astro.url.origin,
  name: 'Shardul Kavar | Portfolio & Blog',
  description:
    'Personal portfolio and technical articles of Shardul Kavar - Full-Stack Developer & Backend Architect.',
  publisher: {
    '@id': `${Astro.url.origin}/#person`,
  },
  inLanguage: 'en-US',
};

const pageSchema = isArticle
  ? {
      '@type': 'BlogPosting',
      '@id': `${canonicalURL}#article`,
      isPartOf: {
        '@id': `${Astro.url.origin}/#website`,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL,
      },
      headline: title,
      description: description,
      image: ogImage,
      author: {
        '@id': `${Astro.url.origin}/#person`,
      },
      publisher: {
        '@id': `${Astro.url.origin}/#person`,
      },
      datePublished: pubDate || new Date().toISOString(),
      dateModified: pubDate || new Date().toISOString(),
      inLanguage: 'en-US',
    }
  : {
      '@type': 'ProfilePage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL,
      name: title,
      description: description,
      isPartOf: {
        '@id': `${Astro.url.origin}/#website`,
      },
      mainEntity: {
        '@id': `${Astro.url.origin}/#person`,
      },
      inLanguage: 'en-US',
    };

const schema = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, websiteSchema, pageSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <link href="/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="/site.webmanifest" rel="manifest" />
    <meta content={Astro.generator} name="generator" />
    <meta name="theme-color" content="#121212" />
    <meta name="color-scheme" content="dark light" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta content={title} name="title" />
    <meta content={description} name="description" />
    <meta content="Shardul Kavar" name="author" />
    <meta
      content="Shardul Kavar, Full-Stack Developer, Backend Architect, Fintech Engineer, PSP Integrations, Node.js, TypeScript, Microservices, Software Engineer Portfolio, India"
      name="keywords"
    />
    <meta
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      name="robots"
    />
    <link href={canonicalURL} rel="canonical" />
    <link
      href="/rss.xml"
      rel="alternate"
      title="Shardul Kavar's Blog"
      type="application/rss+xml"
    />

    <!-- Open Graph / Facebook / LinkedIn -->
    <meta content={isArticle ? 'article' : 'website'} property="og:type" />
    <meta content={canonicalURL} property="og:url" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={ogImage} property="og:image" />
    <meta content={title} property="og:image:alt" />
    <meta content="Shardul Kavar" property="og:site_name" />
    <meta content="en_US" property="og:locale" />
    {pubDate && <meta content={new Date(pubDate).toISOString()} property="article:published_time" />}
    {isArticle && <meta content="Shardul Kavar" property="article:author" />}

    <!-- Twitter / X -->
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={canonicalURL} property="twitter:url" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImage} name="twitter:image" />
    <meta content={title} name="twitter:image:alt" />

    <!-- Structured Data (JSON-LD) -->
    <script
      is:inline
      set:html={JSON.stringify(schema)}
      type="application/ld+json"
    />
  </head>
  <body
    class={`bg-gray-100 dark:bg-darkslate-500 text-gray-900 dark:text-gray-100 flex flex-col items-center ${
      page === 'blog'
        ? 'min-h-screen justify-start'
        : 'min-h-screen md:h-screen md:justify-center'
    }`}
  >
    <slot name="loader" />
    <div class="fixed top-4 right-4 z-50">
      <ThemeSwitcher />
    </div>
    <CursorFollower />
    <slot />
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }

      window.localStorage.setItem('theme', theme);

      const handleToggleClick = () => {
        const element = document.documentElement;
        element.classList.toggle('dark');

        const isDark = element.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      };

      document
        .getElementById('theme-switcher')
        .addEventListener('click', handleToggleClick);
    </script>
  </body>
</html>

<style is:global>
  :root {
    --shadow-s:
      inset 0 1px 2px #ffffff30, /* top highlight */ 0 1px 2px #00000030,
      /* dark shadow */ 0 2px 4px #00000015; /* soft shadow */
    --shadow-m:
      inset 0 1px 2px #ffffff50, /* top highlight */ 0 2px 4px #00000030,
      /* dark shadow */ 0 4px 8px #00000015; /* soft shadow */
    --shadow-l:
      inset 0 1px 2px #ffffff70, /* top highlight */ 0 4px 6px #00000030,
      /* dark shadow */ 0 6px 10px #00000015; /* soft shadow */
    --shadow-s-primary:
      inset 0 1px 2px #ef444450, /* top highlight */ 0 1px 2px #ef4444,
      /* dark shadow */ 0 2px 4px #ef4444; /* soft shadow */
    --shadow-m-primary:
      inset 0 1px 2px #ef444450, /* top highlight */ 0 2px 4px #ef4444,
      /* dark shadow */ 0 4px 8px #ef4444; /* soft shadow */
    --shadow-l-primary:
      inset 0 1px 2px #ef444450, /* top highlight */ 0 4px 6px #ef4444,
      /* dark shadow */ 0 6px 10px #ef4444; /* soft shadow */
  }

  .shadow-s {
    box-shadow: var(--shadow-s);
  }
  .shadow-m {
    box-shadow: var(--shadow-m);
  }
  .shadow-l {
    box-shadow: var(--shadow-l);
  }

  .shadow-s-primary {
    box-shadow: var(--shadow-s-primary);
  }
  .shadow-m-primary {
    box-shadow: var(--shadow-m-primary);
  }
  .shadow-l-primary {
    box-shadow: var(--shadow-l-primary);
  }

  @font-face {
    font-family: 'CabinetGrotesk';
    src: url('/fonts/CabinetGrotesk-Variable.ttf') format('truetype-variations');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }
  @font-face {
    font-family: 'Satoshi';
    src: url('/fonts/Satoshi-Variable.ttf') format('truetype-variations');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
    font-weight: 100 1000;
  }

  body {
    margin: 0;
    font-family: 'Satoshi', sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: 'Cabinet Grotesk', sans-serif;
  }
  p {
    font-family: 'Satoshi';
  }

  b {
    font-weight: 700 !important;
  }

  a {
    text-decoration: none;
    color: inherit;
  }
  @keyframes rainbow-shine {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }

  .rainbow-text {
    background: linear-gradient(
      to right,
      #007aff,
      #00ecff,
      #9400d3,
      #e63946,
      #ff7f00,
      #ffff00,
      #00ff00,
      #007aff
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: rainbow-shine 8s ease-in-out infinite;
    background-size: 400% 100%;
  }
</style>
