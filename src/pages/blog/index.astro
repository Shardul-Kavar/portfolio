---
import { getPublishedPosts } from '../../lib/blog';
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/Blog/PostRow.astro';

const posts = await getPublishedPosts();

const description =
  'Technical articles, software architecture insights, and engineering guides by Shardul Kavar.';
---

<script>
  import { animate, type AnimationSequence } from 'motion';
  import { loaderAnimation } from '../../lib/constants';

  const sequence = [loaderAnimation];

  animate(sequence as AnimationSequence);
</script>

<Layout description={description} page="blog" title="Blog & Technical Articles | Shardul Kavar">
  <main
    class="w-full min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto px-6 py-10 sm:px-8 sm:py-12 pb-36"
  >
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href="/">Back</a
    >
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">Posts</h1>
    <ul class="w-full">
      {
        posts?.map((post) => (
          <PostRow
            date={post.data.publishAt}
            id={post.id}
            title={post.data.title}
          />
        ))
      }
    </ul>
  </main>
</Layout>
