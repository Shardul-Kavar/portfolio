---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card/index.astro';
import IntroCard from '../components/IntroCard.astro';
import ContactsCard from '../components/ContactsCard.astro';
import TimeZone from '../components/TimeZoneCard.astro';
import AboutMe from '../components/AboutMe.astro';
import Now from '../components/Now.astro';
import Hobby from '../components/Hobby.astro';
import Globe from '../components/Globe';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/helpers';
import ExperienceGrid from '../components/ExperienceGrid.astro';
import Slogan from '../components/Slogan.astro';

const posts = (await getCollection('blog'))?.sort(
  (blogEntryA, blogEntryB) =>
    (blogEntryB.data.pubDate || new Date()).getTime() -
    (blogEntryA.data.pubDate || new Date()).getTime()
);
---

<script>
  import { stagger, animate, type AnimationSequence } from 'motion';
  import { loaderAnimation } from '../lib/constants';
  const cards = document.querySelectorAll('.card');

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ['40%', '0%'], opacity: [0, 1] },
      {
        type: 'spring',
        at: '-0.1',
        delay: stagger(0.3),
      },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>

<Layout
  description="Hi, I'm Shardul, a full-stack software developer from India. My primary tools of choice includes: Frontend: HTML5 / CSS3, JavaScript (ES6+), TypeScript, React.js, Next.js Backend: Node.js, Express, Microservices Architecture, REST APIs, GraphQL DevOps & Hosting: AWS (EC2, SNS, S3, Lambda), Vercel, Netlify, NGINX, Docker Integrations: Payment Systems (Stripe, PayPal), Third-party APIs"
  title="Shardul Kavar - Freelance full-stack Developer"
>
  <main
    class="flex flex-col w-full relative grid sm:gap-2 md:gap-4 min-h-screen grid-rows-2 grid-cols-1"
  >
    <div
      class="z-10 m-auto p-2 grid gap-2 max-w-6xl relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:grid-rows-8 lg:grid-cols-4 lg:gap-4 sm:pb-0 md:pb-2 lg:pb-0"
    >
      <Card classname="sm:hidden">
        <div class="flex items-center">
          <img
            width="20"
            height="20"
            src="https://img.icons8.com/fluency/96/sparkles.png"
            class="mr-1 mix-blend-luminosity"
            id="sparkles-image"
          />
          <p class="text-sm font-semibold rainbow-text">
            <!-- import icons8-ai-stars-100.png from public -->
            Robust Backends. Future-Proof Solutions.
          </p>
        </div>
      </Card>
      <IntroCard />
      <AboutMe />
      <ContactsCard />
      <TimeZone />
      <Now />
      <Slogan />
    </div>
    <div
      class="z-10 m-auto p-2 grid gap-2 max-w-6xl relative w-full sm:p-4 sm:gap-2 md:grid-cols-1 md:gap-3 md:p-6 lg:grid-rows-6 lg:grid-cols-1 lg:gap-4 sm:pt-0 md:pt-0 lg:pt-0"
    >
      <Card colSpan="sm:col-span-1" rowSpan="sm:row-span-8" title="Experience">
        <ExperienceGrid />
      </Card>
    </div>
  </main>
</Layout>
