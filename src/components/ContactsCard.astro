---
import Card from './Card/index.astro';
import { LINKS } from '../lib/constants';
import { Icon } from 'astro-icon/components';
---

<Card colSpan="lg:col-span-1" rowSpan="lg:row-span-3">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-gray-900 dark:text-gray-100 text-xl font-bold">
        Let's start working together!
      </h2>
    </header>
    <address class="flex flex-col mt-4 not-italic">
      <h3 class="text-gray-600 dark:text-gray-400 text-sm font-medium">Contact Details</h3>
      <p>
        <a href="mailto:shardulpatel010@gmail.com" class="glow-on-hover"
          >shardulpatel010@gmail.com</a
        >
      </p>
    </address>
    <div class="flex flex-col mt-4 w-fit">
      <h3 class="text-gray-600 dark:text-gray-400 text-sm font-medium">Socials</h3>
      <ul>
        <li>
          <a
            href={LINKS.linkedin}
            target="_blank"
            class="glow-on-hover hover:text-accent-light-500 dark:hover:text-accent-dark-400 transition-colors flex items-center gap-2"
          >
            <Icon class="h-6" name="ri:linkedin-box-fill" />
            <span>Linkedin</span>
          </a>
        </li>
        <li>
          <a
            href={LINKS.github}
            target="_blank"
            class="glow-on-hover hover:text-accent-light-500 dark:hover:text-accent-dark-400 transition-colors flex items-center gap-2"
          >
            <Icon class="h-6" name="ri:github-fill" />
            <span>Github</span>
          </a>
        </li>

        <li>
          <a
            href={LINKS.discord}
            target="_blank"
            class="glow-on-hover hover:text-accent-light-500 dark:hover:text-accent-dark-400 transition-colors flex items-center gap-2"
          >
            <Icon class="h-6" name="ri:discord-fill" />
            <span>Discord</span>
          </a>
        </li>

      </ul>
    </div>

  </div>
</Card>

<style>
  .glow-on-hover {
    transition: box-shadow 0.3s ease-in-out;
  }
  .glow-on-hover:hover {
    box-shadow: 0px 2px 0 var(--color-accent-light-500);
  }
  .dark .glow-on-hover:hover {
    box-shadow: 0px 2px 0 var(--color-accent-dark-400);
  }
</style>
