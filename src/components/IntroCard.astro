---
import Card from './Card/index.astro';
import Button from './Button.astro';
import { LINKS } from '../lib/constants';
import { Icon } from 'astro-icon/components';
import Tooltip from './Tooltip/index';
import { Image } from 'astro:assets';
---

<Card colSpan="lg:col-span-3" rowSpan="lg:row-span-5">
  <div class="flex flex-col md:flex-row w-full h-full">
    <div
      class="flex flex-col justify-between md:max-h-[300px] gap-4 w-full md:w-7/8"
    >
      <div class="flex flex-col h-full">
        <h6 class="text-sm font-light m-0 text-gray-600 dark:text-gray-400">
          welcome
        </h6>
        <p class="m-0 font-light text-xl">
          Hi, I’m <b class="font-bold">Shardul Kavar</b>, a full-stack developer passionate about crafting end-to-end digital experiences. I bring ideas to life by blending intuitive <b>React and Next.js</b> interfaces with highly scalable, secure <b>cloud-native backends</b>.<br />
          My background in the demanding Fintech sector has instilled a rigorous approach to <b>system architecture</b>, data integrity, and real-time communication using tools like <b>Electron, Redux, and Microservices</b>. I thrive on solving complex technical challenges, whether that means optimizing a high-stakes API or internationalizing a global platform.<br />
          Ultimately, my focus is on delivering <b>resilient, maintainable software</b> that empowers businesses to scale seamlessly and provides users with a flawless, engaging experience across all touchpoints.
        </p>
      </div>
    </div>
    <div class="flex flex-col h-full justify-between items-center">
      <Image
        alt="memoji of shardul"
        class="w-auto max-h-[400px] select-none pointer-events-none macbook-image"
        height="400"
        src="/me.png"
        width="400"
      />
      <div class="flex gap-4">
        <a aria-label="github profile" href={LINKS.github} target="_blank">
          <Button aria-label="github profile">
            <Icon class="h-6" name="ri:github-fill" />
            <span class="sr-only">GitHub Profile</span>
          </Button>
        </a>
        <a aria-label="linkedin profile" href={LINKS.linkedin} target="_blank">
          <Button aria-label="linkedin profile">
            <Icon class="h-6" name="ri:linkedin-box-fill" />
            <span class="sr-only">Linkedin Profile</span>
          </Button>
        </a>
        <Tooltip client:visible>
          <Button aria-label="easter egg btn">
            <Icon class="h-6" name="ri:emotion-laugh-line" />
            <span class="sr-only">Easter egg button</span>
          </Button>
        </Tooltip>
      </div>
    </div>
  </div>
</Card>
