---
import Card from './Card/index.astro';
import Button from './Button.astro';
import { LINKS } from '../lib/constants';
import { Icon } from 'astro-icon/components';
import Tooltip from './Tooltip/index';
import { Image } from 'astro:assets';
---

<Card colSpan="lg:col-span-3" rowSpan="lg:row-span-5">
  <div class="flex flex-col md:flex-row w-full h-full">
    <div
      class="flex flex-col justify-between md:max-h-[300px] gap-4 w-full md:w-7/8"
    >
      <div class="flex flex-col h-full">
        <h6 class="text-sm font-light m-0 text-gray-600 dark:text-gray-400">
          welcome
        </h6>
        <p class="m-0 font-light text-xl">
          Hi, I’m <b class="font-bold">Shardul</b>. I specialize in engineering
          the critical infrastructure where finance meets technology.<br />With
          a proven track record of managing <b
            >25+ Payment Service Provider (PSP) integrations</b
          > and navigating complex <b>KYC/AML compliance pipelines</b>, I bridge
          the gap between traditional <b>Fiat banking</b> and the future of <b
            >Crypto assets</b
          >. My expertise lies in transforming undocumented, legacy API
          environments into <b>robust, scalable microservices</b> that handle
          <b>high-stakes transactions with precision</b>.<br />Whether it's
          <b>architecting a 300+ table database</b> for national-scale platforms,
          or <b>securing real-time payment flows</b>, I focus on one goal:
          <b>eliminating technical risk</b> so your business can
          <b>scale without borders.</b>
        </p>
      </div>
    </div>
    <div class="flex flex-col h-full justify-between items-center">
      <Image
        alt="memoji of gianmarco"
        class="w-auto max-h-[400px] select-none pointer-events-none macbook-image"
        height="400"
        src="/me.png"
        width="400"
      />
      <div class="flex gap-4">
        <a aria-label="github profile" href={LINKS.github} target="_blank">
          <Button aria-label="github profile">
            <Icon class="h-6" name="ri:github-fill" />
            <span class="sr-only">GitHub Profile</span>
          </Button>
        </a>
        <a aria-label="linkedin profile" href={LINKS.linkedin} target="_blank">
          <Button aria-label="linkedin profile">
            <Icon class="h-6" name="ri:linkedin-box-fill" />
            <span class="sr-only">Linkedin Profile</span>
          </Button>
        </a>
        <a aria-label="blog" href="/blog">
          <Button aria-label="blog">
            <Icon class="h-6" name="ri:article-line" />
            <span class="sr-only">Blog</span>
          </Button>
        </a>
        <!-- <Tooltip client:visible>
          <Button aria-label="easter egg btn">
            <Icon class="h-6" name="ri:emotion-laugh-line" />
            <span class="sr-only">Easter egg button</span>
          </Button>
        </Tooltip> -->
      </div>
    </div>
  </div>
</Card>
