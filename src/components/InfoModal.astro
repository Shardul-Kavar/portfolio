---
import Card from './Card/index.astro';
---

<div
  id="info-modal"
  class="fixed inset-0 bg-black bg-opacity-70 backdrop-blur-sm hidden z-50 items-center justify-center p-4"
  onclick="if (event.target === this) { this.classList.remove('flex'); this.classList.add('hidden'); }"
>
  <Card
    colSpan="lg:col-span-3"
    rowSpan="lg:row-span-3"
    classname="max-w-2xl w-full"
  >
    <button
      id="modal-close-button"
      class="absolute top-2 right-2 text-gray-400 hover:text-white text-2xl leading-none w-8 h-8 rounded-full flex items-center justify-center"
      aria-label="Close modal"
      onclick="document.getElementById('info-modal').classList.remove('flex'); document.getElementById('info-modal').classList.add('hidden');"
    >
      &times;
    </button>
    <slot />
  </Card>
</div>
