  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 row-span-5 pt-4">
    {
      projects.map((project) => (
        <Card
          colSpan="md:col-span-1"
          classname="bg-gray-50 dark:bg-[#121212] border-gray-200 dark:border-white/10 hover:border-accent-light-500/50 dark:hover:border-accent-dark-400/50"
        >
          <h3 class="text-xl font-bold mb-2 text-gray-900 dark:text-gray-100">{project.title}</h3>
          <p class="text-lg text-gray-600 dark:text-white/70 mb-4">{project.role}</p>

          <ul class="text-gray-700 dark:text-white/90 space-y-3 mb-6">
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">Challenge:</strong>{' '}
              <span class="text-gray-600 dark:text-white/80">{project.challenge}</span>
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">Solution:</strong>{' '}
              <span class="text-gray-600 dark:text-white/80">{project.solution}</span>
            </li>
            <li>
              <strong class="font-semibold text-gray-900 dark:text-gray-100">Impact:</strong>{' '}
              <span class="text-gray-600 dark:text-white/80">{project.impact}</span>
            </li>
          </ul>

          <div class="flex flex-wrap gap-2">
            {project.tech.map((tech) => {
              const badge = techToBadge[tech];
              if (!badge) return null;
              const badgeUrl = `https://img.shields.io/badge/${encodeURIComponent(
                tech
              )}-${badge.color}?style=plastic&logo=${badge.logo}&logoColor=white`;
              return <img src={badgeUrl} alt={tech} />;
            })}
          </div>
        </Card>
      ))
    }
  </div>
</div>
