---
interface Props {
  rounded?: boolean;
}

const { rounded } = Astro.props;
---

<button
  class={`custom-btn text-xl max-h-[50px] shadow-m shadow-gray-900/20 active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-gray-900 dark:text-gray-200 px-5 py-2 border border-accent-light-500 border-none hover:text-accent-light-500 dark:hover:text-accent-dark-400 transition-colors duration-100 ease-in-out bg-gray-100 dark:bg-gray-900 cursor-pointer ${
    rounded ? 'rounded-full' : 'rounded-lg'
  } hover:shadow-red-600 hover:bg-red-900`}
>
  <slot />
</button>
