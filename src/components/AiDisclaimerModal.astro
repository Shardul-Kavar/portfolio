<style>
  /* Basic styling for the modal, UnoCSS should handle most of it */
  /* You might need to adjust z-index if other elements conflict */
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const closeButton = document.getElementById('ai-modal-close-button');
    const modal = document.getElementById('ai-disclaimer-modal');
    const openCertificatesButton = document.getElementById('open-certificates-carousel-button');

    if (!closeButton || !modal || !openCertificatesButton) {
      console.log("+++++++++++++++++++++++++++++++")
      return;
    }

    // Ensure modal is hidden on initial load
    modal.classList.add('hidden');
    modal.setAttribute('aria-hidden', 'true');

    const toggleModal = (shouldOpen) => {
      if (shouldOpen) {
        modal.classList.remove('hidden');
        modal.setAttribute('aria-hidden', 'false');
      } else {
        modal.classList.add('hidden');
        modal.setAttribute('aria-hidden', 'true');
      }
    };

    document.addEventListener('open-ai-disclaimer-modal', () => toggleModal(true)); // Open via custom event
    closeButton.addEventListener('click', () => toggleModal(false)); // Close via button click

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        toggleModal(false);
      }
    });

    // Close with escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        toggleModal(false);
      }
    });

    // Event listener for the new certificates button
    openCertificatesButton.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('open-certificates-carousel-modal'));
      toggleModal(false); // Close the disclaimer modal when opening the carousel
    });
  });
</script>
