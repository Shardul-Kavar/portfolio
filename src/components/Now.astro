---
import Card from './Card/index.astro';
import Pulse from './Pulse.astro';
---

<Card colSpan="lg:col-span-1" rowSpan="lg:row-span-2" title="Now">
  <div class="flex justify-between w-full items-start mb-2 relative">
    <div class="absolute right-0 top-[-20px]">
      <!-- <h2>Now</h2> -->
      <Pulse />
    </div>
  </div>
  <div class="mb-2">
    <p class="text-xs text-gray-600 dark:text-gray-400">
      Currently open to new opportunities and collaborations.
    </p>
  </div>
  <p class="text-xs">
    <span class="text-xs text-gray-600 dark:text-gray-400"
      >Favourites:
    </span><br />
    Fintech / AI / Third-party integrations / Production quality prototypes
  </p>
</Card>
