---
import Card from './Card/index.astro';
import Pulse from './Pulse.astro';
---

<Card colSpan="lg:col-span-1" rowSpan="lg:row-span-2">
  <div class="flex justify-between w-full items-start mb-2">
    <div class="flex flex-col">
      <h2>Now</h2>
    </div>
    <Pulse />
  </div>
  <div class="mb-2">
    <p class="text-xs text-gray-400">
      <!-- Currently open to new opportunities and collaborations. -->
      <!-- <span>&bull;</span> Working as an Independent Contractor for a leading
      fintech startup. <br /> -->
      <span>&bull;</span> Currently open to new opportunities and collaborations.
    </p>
  </div>
  <p class="text-xs">
    <span class="text-xs text-gray-500">Favourites: </span><br />
    Fintech / AI / Third-party integrations / Production quality prototypes
  </p>
</Card>
