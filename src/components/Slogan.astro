---
import Card from './Card/index.astro';
---

<div class="hidden sm:block md:col-span-1 lg:col-span-2">
  <Card colSpan="lg:col-span-2" rowSpan="lg:row-span-1">
    <div class="flex items-center min-h-[33px]">
      <img
        width="20"
        height="20"
        src="https://img.icons8.com/fluency/96/sparkles.png"
        class="mr-1 mix-blend-luminosity"
        id="sparkles-image"
      />
      <p class="text-sm font-semibold rainbow-text">
        Robust Solutions. Seamless Experiences.
      </p>
    </div>
  </Card>
</div>
