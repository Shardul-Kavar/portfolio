---
import { Icon } from 'astro-icon/components';

interface Props {
  open?: boolean;
  title?: string;
  body?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  onCloseLabel?: string;
  className?: string;
}

const {
  open = false,
  title,
  body,
  size = 'md',
  onCloseLabel = 'Close modal',
  className = '',
} = Astro.props;

const sizes: Record<string, string> = {
  sm: 'max-w-sm',
  md: 'max-w-lg',
  lg: 'max-w-2xl',
  xl: 'max-w-4xl',
};
---

{
  /*
  Usage:
  <Modal open={modalOpen} title="Title" body="Optional body" />
*/
}

<div
  class={`fixed inset-0 z-50 ${open ? 'pointer-events-auto' : 'pointer-events-none'}`}
  aria-hidden={open ? 'false' : 'true'}
>
  {/* Backdrop */}
  <div
    class={`absolute inset-0 bg-black/70 backdrop-blur-[1px] transition-opacity duration-150 ease-out ${open ? 'opacity-100' : 'opacity-0'}`}
  >
  </div>

  {/* Modal panel wrapper */}
  <div class="absolute inset-0 flex items-center justify-center p-4">
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby={title ? 'modal-title' : undefined}
      aria-describedby={body ? 'modal-desc' : undefined}
      class={`w-full ${sizes[size]} relative rounded-lg border border-darkslate-100 bg-darkslate-500 shadow-2xl
        transition-all duration-150 ease-out
        ${open ? 'opacity-100 translate-y-0 scale-100' : 'opacity-0 translate-y-2 scale-[0.98]'}
        ${className}
      `}
      tabindex="-1"
      id="modal-panel"
    >
      {/* Close button */}
      <button
        type="button"
        aria-label={onCloseLabel}
        class="absolute right-3 top-3 inline-flex items-center justify-center rounded-md
               text-slate-300 hover:text-primary-500 hover:-translate-y-0.5 hover:translate-x-0.5
               transition-transform duration-100 focus:outline-none focus:ring-2 focus:ring-primary-500/60"
        data-modal-close
      >
        <Icon name="ri:close-line" class="h-5 w-5" />
      </button>

      {/* Content */}
      <div class="p-5 sm:p-6">
        {
          title && (
            <h2 id="modal-title" class="text-xl font-bold m-0 z-20">
              {title}
            </h2>
          )
        }
        {
          body && (
            <p id="modal-desc" class="mt-2 m-0 font-light text-base">
              {body}
            </p>
          )
        }
        <div class="mt-4">
          <slot />
        </div>
      </div>

      {/* Footer slot (optional) */}
      <div class="px-5 sm:px-6 pb-5 flex items-center gap-3">
        <slot name="footer" />
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Minimal interactivity: trap focus, ESC to close, body scroll lock
  const root = document.currentScript?.closest('div.fixed');
  if (!root) return;
  const panel = root.querySelector('#modal-panel');
  const backdrop = root.querySelector('div.absolute.inset-0.bg-black\\/70');
  const closeBtn = root.querySelector('[data-modal-close]');

  const isOpen = () => !root.classList.contains('pointer-events-none');

  const preventScroll = (on) => {
    document.documentElement.style.overflow = on ? 'hidden' : '';
    document.body.style.overflow = on ? 'hidden' : '';
  };

  const focusable = () =>
    panel?.querySelectorAll(
      'a,button,input,textarea,select,details,[tabindex]:not([tabindex="-1"])'
    ) ?? [];

  const trap = (e) => {
    if (!isOpen() || !panel) return;
    const nodes = Array.from(focusable()).filter(
      (el) => !el.hasAttribute('disabled')
    );
    if (nodes.length === 0) return;
    const first = nodes[0];
    const last = nodes[nodes.length - 1];
    if (e.key === 'Tab') {
      if (e.shiftKey && document.activeElement === first) {
        last.focus();
        e.preventDefault();
      } else if (!e.shiftKey && document.activeElement === last) {
        first.focus();
        e.preventDefault();
      }
    } else if (e.key === 'Escape') {
      root.dispatchEvent(new CustomEvent('modal:close', { bubbles: true }));
    }
  };

  const openObserver = new MutationObserver(() => {
    if (isOpen()) {
      preventScroll(true);
      // focus first focusable or panel
      setTimeout(() => {
        const nodes = focusable();
        (nodes[0] || panel)?.focus();
      }, 0);
    } else {
      preventScroll(false);
    }
  });

  openObserver.observe(root, { attributes: true, attributeFilter: ['class'] });

  // Close interactions
  backdrop?.addEventListener('click', () => {
    root.dispatchEvent(new CustomEvent('modal:close', { bubbles: true }));
  });
  closeBtn?.addEventListener('click', () => {
    root.dispatchEvent(new CustomEvent('modal:close', { bubbles: true }));
  });
  window.addEventListener('keydown', trap);

  // Cleanup on disconnect
  new MutationObserver((records, obs) => {
    if (!document.body.contains(root)) {
      window.removeEventListener('keydown', trap);
      obs.disconnect();
      openObserver.disconnect();
      preventScroll(false);
    }
  }).observe(document.body, { childList: true, subtree: true });
</script>
