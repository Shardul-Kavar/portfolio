---
interface Props {
  open?: boolean;
}
const { open = false } = Astro.props;
---

<div class="inline-block">
  <button
    type="button"
    class="inline-flex items-center gap-2 rounded-md border border-darkslate-100 bg-darkslate-500 px-3 py-2
           text-slate-200 shadow-lg hover:border-primary-500 hover:text-primary-500 transition
           focus:outline-none focus:ring-2 focus:ring-primary-500/60"
  >
    <slot>Open modal</slot>
  </button>
</div>
